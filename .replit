modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
CLICKHOUSE_DATABASE = "default"
CLICKHOUSE_HOST = ""
CLICKHOUSE_URL = "https://te3tb0km3a.europe-west2.gcp.clickhouse.cloud:8443"
CLICKHOUSE_USER = "default"
GRAFANA_MCP_ENDPOINT = "https://mcp.grafana.com/mcp"
GRAFANA_URL = "https://heftyparlor730.grafana.net/"
LOG_LEVEL = "info"
