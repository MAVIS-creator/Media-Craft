# ==========================================
# MediaCraft AI - Environment Variables Guide
# ==========================================

# 1. Google Gemini AI (Required for FFmpeg Planning & Self-Healing Repair)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Parallel Web Search (For Technical FFmpeg & Codec Spec Grounding)
# Get from: Parallel Dashboard -> Web Tools -> Search the web -> API Keys
PARALLEL_API_KEY=your_parallel_api_key_here

# 3. Grafana Cloud MCP (For Blockbuster Hackathon Observability & Telemetry)
# URL of your Grafana Cloud instance (e.g. https://my-org.grafana.net)
GRAFANA_URL=https://<your-stack-name>.grafana.net
# Grafana Cloud Service Account Token / API Key with Editor or Assistant Cloud MCP User permissions
GRAFANA_API_KEY=your_grafana_service_account_token_here
# Optional: Hosted MCP Endpoint (Defaults to https://mcp.grafana.com/mcp)
GRAFANA_MCP_ENDPOINT=https://mcp.grafana.com/mcp

# 4. ClickHouse Cloud (For Transcoding & Media Job Analytics)
# Get from: ClickHouse Cloud Service Details -> Connection string (HTTPS)
CLICKHOUSE_URL=https://<your-service-host>.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_clickhouse_password_here
CLICKHOUSE_DATABASE=default
